# Exclude source files (PDFs, captures) but keep the index
sources/*
!sources/SOURCE_INDEX.md
!sources/sources.csv
!sources/publishers.csv

# Claude Code local settings
.claude/

# Dashboard pipeline — PRIVATE inputs stay local, never published.
# The denylist *contains* the very internal tokens it screens for, and the
# raw findings file holds held/unpublished leads + analyst notes. Only the
# build script (tools/) and the sanitized outputs (dashboard_data/) are public.
/tools/denylist.txt
/dashboard_src/

# Python build artifacts
__pycache__/
*.pyc

# Monitor output (tools/monitor.py) - published as a workflow artifact, never committed
/monitor-out/
